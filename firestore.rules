rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function currentUserProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isLpgAdmin() {
      return signedIn() && currentUserProfile().status == 'ACTIVE' &&
        currentUserProfile().role in [
          'SUPER_ADMIN', 'DISPERINDAG_ADMIN', 'LPG_ADMIN', 'INDUSTRY_ESDM_EDITOR'
        ];
    }

    function isSuperAdmin() {
      return signedIn() && currentUserProfile().status == 'ACTIVE' &&
        currentUserProfile().role == 'SUPER_ADMIN';
    }

    function isMarketAdmin() {
      return signedIn() && currentUserProfile().status == 'ACTIVE' &&
        currentUserProfile().role in [
          'SUPER_ADMIN', 'DISPERINDAGESDM_ADMIN', 'DISPERINDAG_ADMIN',
          'TRADE_EDITOR', 'DISTRIBUTION_EDITOR'
        ];
    }

    function isMediaIntelligenceAdmin() {
      return signedIn() && currentUserProfile().status == 'ACTIVE' &&
        currentUserProfile().role in [
          'SUPER_ADMIN', 'DISPERINDAG_ADMIN', 'PUBLIC_RELATIONS_EDITOR',
          'INDUSTRY_ESDM_EDITOR'
        ];
    }

    function isContentAdmin() {
      return signedIn() && currentUserProfile().status == 'ACTIVE' &&
        currentUserProfile().role in [
          'SUPER_ADMIN', 'DISPERINDAG_ADMIN', 'SECRETARIAT_ADMIN',
          'TRADE_EDITOR', 'INDUSTRY_ESDM_EDITOR', 'METROLOGY_EDITOR',
          'DISTRIBUTION_EDITOR', 'PUBLIC_RELATIONS_EDITOR', 'LPG_ADMIN'
        ];
    }

    function isReportsAdmin() {
      return signedIn() && currentUserProfile().status == 'ACTIVE' &&
        currentUserProfile().role in [
          'SUPER_ADMIN', 'DISPERINDAG_ADMIN', 'SECRETARIAT_ADMIN',
          'PUBLIC_RELATIONS_EDITOR'
        ];
    }

    function validMediaReviewAudit(eventId, entityType, entityId) {
      let audit = getAfter(/databases/$(database)/documents/mi_audit_logs/$(eventId));
      return eventId is string && eventId.size() >= 16 && eventId.size() <= 100 &&
        existsAfter(/databases/$(database)/documents/mi_audit_logs/$(eventId)) &&
        audit.data.event_id == eventId &&
        audit.data.entity_type == entityType && audit.data.entity_id == entityId &&
        audit.data.actor_uid == request.auth.uid &&
        audit.data.actor_role == currentUserProfile().role && audit.data.created_at == request.time;
    }

    function validMediaReviewMetadata(entityType, entityId) {
      return request.resource.data.reviewed_by == request.auth.uid &&
        request.resource.data.reviewed_at == request.time &&
        validMediaReviewAudit(request.resource.data.review_event_id, entityType, entityId);
    }

    function validMediaItemAction() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let action = getAfter(/databases/$(database)/documents/mi_audit_logs/$(request.resource.data.review_event_id)).data.action;
      return (action in ['ACCEPT', 'REJECT'] && changed.hasOnly([
          'reviewed_by', 'reviewed_at', 'review_event_id', 'review_notes', 'updated_at', 'verification_status'
        ])) || (action == 'EDIT' && changed.hasOnly([
          'reviewed_by', 'reviewed_at', 'review_event_id', 'review_notes', 'updated_at',
          'title', 'excerpt', 'topic_ids', 'district_ids'
        ])) || (action == 'MERGE_STORY' && changed.hasOnly([
          'reviewed_by', 'reviewed_at', 'review_event_id', 'review_notes', 'updated_at', 'story_cluster_id'
        ])) || (action == 'ATTACH_ISSUE' && changed.hasOnly([
          'reviewed_by', 'reviewed_at', 'review_event_id', 'review_notes', 'updated_at', 'issue_id'
        ]));
    }

    function validMediaIssueAction() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let action = getAfter(/databases/$(database)/documents/mi_audit_logs/$(request.resource.data.review_event_id)).data.action;
      return (action in ['ACCEPT', 'REJECT'] && changed.hasOnly([
          'reviewed_by', 'reviewed_at', 'review_event_id', 'review_notes', 'updated_at',
          'verification_status', 'status'
        ])) || (action == 'EDIT' && changed.hasOnly([
          'reviewed_by', 'reviewed_at', 'review_event_id', 'review_notes', 'updated_at', 'title', 'status'
        ])) || (action == 'SET_SEVERITY' && changed.hasOnly([
          'reviewed_by', 'reviewed_at', 'review_event_id', 'review_notes', 'updated_at', 'severity'
        ]));
    }

    function ownsLpgAgent(agentId) {
      return signedIn() && currentUserProfile().status == 'ACTIVE' &&
        currentUserProfile().agentId != null && currentUserProfile().agentId == agentId;
    }

    // 1. DATA PUBLIK KEDINASAN
    match /prices/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /prices_current/{docId} {
      allow read: if true;
      allow write: if isMarketAdmin();
    }
    match /price_history/{docId} {
      allow read: if isMarketAdmin();
      allow write: if false;
    }
    match /sembako/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // --- INTEGRASI HARGA BAPOK SP2KP KEMENDAG (KABUPATEN PINRANG 7315) ---
    // Writer SP2KP hanya berjalan pada lingkungan tepercaya melalui Admin SDK
    // dan ADC/WIF. Seluruh client browser tetap read-only.
    match /market_prices_latest/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /market_prices_history/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /sp2kp_pilot/{docId} {
      allow read: if isMarketAdmin();
      allow write: if false;
    }
    match /sp2kp_sync_snapshots/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /price_overrides/{docId} {
      allow read: if signedIn();
      allow write: if isMarketAdmin() || isSuperAdmin();
    }
    match /price_references/{docId} {
      allow read: if true;
      allow write: if isMarketAdmin() || isSuperAdmin();
    }

    // Monitoring harga pasar lokal adalah sumber independen dari SP2KP.
    // Publik hanya dapat membaca batch dan observasi yang telah diterbitkan.
    match /marketPriceSources/{docId} {
      allow read: if (resource.data.status == 'active') || isMarketAdmin();
      allow create, update: if isMarketAdmin();
      allow delete: if false;
    }
    match /marketCommodityMappings/{docId} {
      allow read, create, update: if isMarketAdmin();
      allow delete: if false;
    }
    match /marketPriceImportBatches/{docId} {
      allow read: if resource.data.status == 'published' || isMarketAdmin();
      allow create: if isMarketAdmin() &&
        request.resource.data.batchId == docId &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.status in ['staging', 'needs_review'] &&
        request.resource.data.fileHash is string && request.resource.data.fileHash.size() == 64 &&
        request.resource.data.marketId is string &&
        exists(/databases/$(database)/documents/markets/$(request.resource.data.marketId));
      allow update: if isMarketAdmin() && resource.data.status != 'published' &&
        request.resource.data.batchId == resource.data.batchId &&
        request.resource.data.fileHash == resource.data.fileHash &&
        request.resource.data.marketId == resource.data.marketId &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.status in ['staging', 'needs_review', 'failed', 'published'];
      allow delete: if false;
    }
    match /marketPriceObservations/{docId} {
      allow read: if isMarketAdmin();
      allow create: if isMarketAdmin() &&
        request.resource.data.status == 'staged' &&
        request.resource.data.dataStatus == 'valid' &&
        request.resource.data.price is number && request.resource.data.price > 0 &&
        request.resource.data.batchId is string &&
        request.resource.data.marketId is string &&
        exists(/databases/$(database)/documents/markets/$(request.resource.data.marketId));
      allow update: if false;
      allow delete: if false;
    }
    match /marketPricePublications/{docId} {
      allow read: if resource.data.status == 'published' && resource.data.dataStatus == 'valid';
      allow create: if isMarketAdmin() &&
        request.resource.data.batchId == docId && request.resource.data.status == 'published' &&
        request.resource.data.dataStatus == 'valid' && request.resource.data.observations is list &&
        request.resource.data.observations.size() > 0 && request.resource.data.observations.size() <= 2000 &&
        getAfter(/databases/$(database)/documents/marketPriceImportBatches/$(docId)).data.status == 'published';
      allow update, delete: if false;
    }
    match /marketPriceAuditLogs/{docId} {
      allow read: if isMarketAdmin();
      allow create: if isMarketAdmin() &&
        request.resource.data.eventId == docId &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /news/{docId} {
      allow read: if resource.data.status == 'published' || signedIn();
      allow create, update, delete: if signedIn() &&
        currentUserProfile().status == 'ACTIVE' &&
        currentUserProfile().role in [
          'SUPER_ADMIN', 'DISPERINDAG_ADMIN', 'SECRETARIAT_ADMIN',
          'TRADE_EDITOR', 'INDUSTRY_ESDM_EDITOR', 'METROLOGY_EDITOR',
          'DISTRIBUTION_EDITOR', 'PUBLIC_RELATIONS_EDITOR', 'LPG_ADMIN'
        ];
    }
    match /ikm_products/{docId} {
      allow read: if true;
      allow write: if signedIn() && currentUserProfile().status == 'ACTIVE' &&
        currentUserProfile().role in ['SUPER_ADMIN', 'DISPERINDAG_ADMIN', 'INDUSTRY_ESDM_EDITOR'];
    }
    match /documents/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /banners/{docId} {
      allow read: if true;
      allow write: if false;
    }
    // Command Center: write hanya admin — mencegah pemalsuan data wallboard publik.
    match /command_center/{document=**} {
      allow read: if true;
      allow write: if isLpgAdmin() || isSuperAdmin();
    }
    match /districts/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /markets/{docId} {
      allow read: if true;
      allow create, update: if isMarketAdmin();
      allow delete: if false;
    }
    match /administrative_villages/{docId} {
      allow read: if true;
      allow write: if isLpgAdmin() || isSuperAdmin();
    }
    match /administrative_meta/{docId} {
      allow read: if true;
      allow write: if isLpgAdmin() || isSuperAdmin();
    }
    match /skm/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /settings/banners {
      allow read: if true;
      allow create, update: if isContentAdmin() &&
        request.resource.data.keys().hasOnly(['list', 'deleted_ids', 'updated_at']) &&
        request.resource.data.list is list && request.resource.data.list.size() <= 30 &&
        (!request.resource.data.keys().hasAny(['deleted_ids']) ||
          (request.resource.data.deleted_ids is list && request.resource.data.deleted_ids.size() <= 500)) &&
        (!request.resource.data.keys().hasAny(['updated_at']) || request.resource.data.updated_at is string);
      allow delete: if false;
    }
    match /settings/deleted_news {
      allow read: if isContentAdmin();
      allow create, update: if isContentAdmin() &&
        request.resource.data.keys().hasOnly(['list', 'updatedAt']) &&
        request.resource.data.list is list && request.resource.data.list.size() <= 500;
      allow delete: if false;
    }
    match /system_config/{configId} {
      allow read: if isContentAdmin();
      allow create, update: if isSuperAdmin();
      allow delete: if false;
    }
    match /tvSlides/{docId} {
      allow read: if true;
      allow write: if signedIn() && currentUserProfile().status == 'ACTIVE' &&
        currentUserProfile().role in ['SUPER_ADMIN', 'DISPERINDAGESDM_ADMIN', 'DISPERINDAG_ADMIN', 'PUBLIC_RELATIONS_EDITOR'];
    }

    // 4. MEDIA INTELLIGENCE HUB
    match /mi_public/{docId} {
      allow read: if docId == 'current';
      allow write: if false;
    }
    match /mi_sources/{sourceId} {
      allow read: if isMediaIntelligenceAdmin();
      allow write: if false;
    }
    match /mi_items/{itemId} {
      allow read: if isMediaIntelligenceAdmin();
      allow create, delete: if false;
      allow update: if isMediaIntelligenceAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'excerpt', 'topic_ids', 'district_ids', 'verification_status',
          'story_cluster_id', 'issue_id', 'reviewed_by', 'reviewed_at',
          'review_event_id', 'review_notes', 'updated_at'
        ]) &&
        request.resource.data.verification_status in [
          'VERIFIED_DIRECT', 'VERIFIED_FEED', 'MANUAL_VERIFIED', 'REJECTED', 'NEEDS_REVIEW'
        ] && request.resource.data.title is string && request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 500 && request.resource.data.excerpt is string &&
        request.resource.data.excerpt.size() <= 2000 && request.resource.data.topic_ids is list &&
        request.resource.data.district_ids is list && request.resource.data.updated_at == request.time &&
        (request.resource.data.story_cluster_id == null ||
          exists(/databases/$(database)/documents/mi_story_clusters/$(request.resource.data.story_cluster_id))) &&
        (request.resource.data.issue_id == null ||
          exists(/databases/$(database)/documents/mi_issues/$(request.resource.data.issue_id))) &&
        validMediaReviewMetadata('ITEM', itemId) && validMediaItemAction();
    }
    match /mi_source_state/{sourceId} {
      allow read: if isMediaIntelligenceAdmin();
      allow write: if false;
    }
    match /mi_sync_runs/{runId} {
      allow read: if isMediaIntelligenceAdmin();
      allow write: if false;
    }
    match /mi_story_clusters/{clusterId} {
      allow read: if isMediaIntelligenceAdmin();
      allow write: if false;
    }
    match /mi_issues/{issueId} {
      allow read: if isMediaIntelligenceAdmin();
      allow create, delete: if false;
      allow update: if isMediaIntelligenceAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'status', 'severity', 'verification_status', 'story_cluster_id',
          'reviewed_by', 'reviewed_at', 'review_event_id', 'review_notes', 'updated_at'
        ]) && request.resource.data.severity in ['LOW', 'MEDIUM', 'HIGH', 'CRITICAL'] &&
        request.resource.data.status in ['OPEN', 'MONITORING', 'RESOLVED', 'DISMISSED'] &&
        request.resource.data.verification_status in ['UNVERIFIED', 'VERIFIED', 'REJECTED'] &&
        request.resource.data.title is string && request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 500 && request.resource.data.updated_at == request.time &&
        validMediaReviewMetadata('ISSUE', issueId) && validMediaIssueAction();
    }
    match /mi_review_tasks/{taskId} {
      allow read: if isMediaIntelligenceAdmin();
      allow create, delete: if false;
      allow update: if isMediaIntelligenceAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'disposition', 'reviewed_by', 'reviewed_at', 'review_event_id',
          'review_notes', 'updated_at'
        ]) && request.resource.data.status in ['OPEN', 'ACCEPTED', 'REJECTED', 'COMPLETED'] &&
        request.resource.data.updated_at == request.time &&
        validMediaReviewMetadata('REVIEW_TASK', taskId);
    }
    match /mi_daily_metrics/{metricId} {
      allow read: if isMediaIntelligenceAdmin();
      allow write: if false;
    }
    match /mi_audit_logs/{logId} {
      allow read: if isMediaIntelligenceAdmin();
      allow create: if isMediaIntelligenceAdmin() && request.resource.data.keys().hasOnly([
          'event_id', 'action', 'entity_type', 'entity_id', 'actor_uid', 'actor_role',
          'before', 'after', 'reason', 'created_at'
        ]) && request.resource.data.event_id == logId &&
        request.resource.data.actor_uid == request.auth.uid &&
        request.resource.data.action in [
          'ACCEPT', 'REJECT', 'EDIT', 'MERGE_STORY', 'ATTACH_ISSUE', 'SET_SEVERITY'
        ] && request.resource.data.entity_type in ['ITEM', 'ISSUE', 'REVIEW_TASK'] &&
        request.resource.data.entity_id is string && request.resource.data.actor_role is string &&
        request.resource.data.before is map && request.resource.data.after is map &&
        request.resource.data.reason is string && request.resource.data.reason.size() <= 1000 &&
        request.resource.data.created_at == request.time;
      allow update, delete: if false;
    }

    // Legacy deprecated collections
    match /media_intelligence_feeds/{docId} { allow read, write: if false; }
    match /media_intelligence_summary/{docId} { allow read, write: if false; }
    match /media_intelligence_trending/{docId} { allow read, write: if false; }
    match /dashboard_snapshot/{docId} { allow read, write: if false; }
    match /dashboard/{docId} { allow read, write: if false; }
    match /config/{document=**} { allow read, write: if false; }
    match /mentions/{docId} { allow read, write: if false; }
    match /issues/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // 2. KANAL PENGADUAN MASYARAKAT
    match /reports/{reportId} {
      allow create: if request.resource.data.keys().hasOnly([
          'id', 'ticket_number', 'submitted_at', 'nama', 'kontak', 'kategori',
          'lokasi', 'judul', 'pesan', 'assigned_unit', 'status', 'resolution',
          'createdAt'
        ]) &&
        request.resource.data.id == reportId && request.resource.data.id is string && request.resource.data.id.size() >= 12 && request.resource.data.id.size() <= 80 && request.resource.data.id.matches('[A-Za-z0-9_-]+') &&
        request.resource.data.ticket_number is string && request.resource.data.ticket_number.matches('DPE-[0-9]{4}-[0-9]{6}') &&
        request.resource.data.nama is string && request.resource.data.nama.size() >= 2 && request.resource.data.nama.size() <= 120 && request.resource.data.nama.matches('[^<>]*') &&
        request.resource.data.kontak is string && request.resource.data.kontak.size() >= 6 && request.resource.data.kontak.size() <= 40 && request.resource.data.kontak.matches('[^<>]*') &&
        request.resource.data.kategori is string && request.resource.data.kategori.size() >= 2 && request.resource.data.kategori.size() <= 80 && request.resource.data.kategori.matches('[^<>]*') &&
        request.resource.data.lokasi is string && request.resource.data.lokasi.size() <= 200 && request.resource.data.lokasi.matches('[^<>]*') &&
        request.resource.data.judul is string && request.resource.data.judul.size() <= 200 && request.resource.data.judul.matches('[^<>]*') &&
        request.resource.data.pesan is string && request.resource.data.pesan.size() >= 6 && request.resource.data.pesan.size() <= 4000 && request.resource.data.pesan.matches('[^<>]*') &&
        request.resource.data.assigned_unit is string && request.resource.data.assigned_unit.size() <= 120 &&
        request.resource.data.status == 'Diterima & Sedang Diverifikasi' &&
        request.resource.data.resolution is string && request.resource.data.resolution.size() <= 300 &&
        request.resource.data.createdAt == request.time;
      allow read: if isReportsAdmin();
      allow update: if isReportsAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'assigned_unit', 'resolution', 'step', 'updated_at', 'updatedAt'
        ]) &&
        request.resource.data.status in [
          'Diterima & Registrasi', 'Verifikasi & Analisis', 'Penugasan Unit Lapangan',
          'Sedang Ditindaklanjuti Tim', 'Penyusunan Respon Pelapor',
          'Selesai Ditindaklanjuti', 'Ditolak / Tidak Sesuai Kewenangan'
        ] &&
        request.resource.data.assigned_unit is string && request.resource.data.assigned_unit.size() <= 160 && request.resource.data.assigned_unit.matches('[^<>]*') &&
        request.resource.data.resolution is string && request.resource.data.resolution.size() <= 4000 && request.resource.data.resolution.matches('[^<>]*') &&
        request.resource.data.step is int && request.resource.data.step >= 1 && request.resource.data.step <= 6 &&
        request.resource.data.updated_at is string && request.resource.data.updatedAt == request.time;
      allow delete: if isSuperAdmin();
    }
    match /reports_current/{reportId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 3. MODUL LPG
    match /lpg_agents/{agentId} {
      allow read: if true;
      allow create: if isLpgAdmin();
      allow update: if isLpgAdmin() || (
        ownsLpgAgent(agentId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'picName', 'phone', 'email', 'address', 'location', 'updatedAt', 'updatedBy', 'version'
        ]) && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time
      );
      allow delete: if false;
    }

    match /lpg_pangkalan/{pangkalanId} {
      allow read: if true;
      allow create: if isLpgAdmin() || (
        ownsLpgAgent(request.resource.data.agentId) &&
        request.resource.data.status == 'ACTIVE' &&
        request.resource.data.isDeleted == false &&
        request.resource.data.verificationStatus == 'PENDING_ADMIN_VERIFICATION'
      );
      allow update: if isLpgAdmin() || (
        ownsLpgAgent(resource.data.agentId) &&
        request.resource.data.agentId == resource.data.agentId &&
        request.resource.data.sourceOriginal == resource.data.sourceOriginal &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'normalizedName', 'ownerName', 'phone', 'kecamatan',
          'desaKelurahan', 'address', 'latitude', 'longitude',
          'location', 'notes', 'updatedAt', 'updatedBy', 'version'
        ])
      );
      allow delete: if false;
    }

    match /lpg_events/{eventId} {
      allow read: if isLpgAdmin() || ownsLpgAgent(resource.data.agentId);
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly([
          'agentId', 'clientEventId', 'type', 'quantity', 'delta',
          'pangkalanId', 'pangkalanSnapshot', 'effectiveAt', 'doNumber',
          'vehicleNumber', 'note', 'correctionOfEventId', 'createdBy', 'createdAt'
        ]) &&
        (ownsLpgAgent(request.resource.data.agentId) || isLpgAdmin()) &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.quantity is int &&
        request.resource.data.quantity > 0 &&
        request.resource.data.createdAt == request.time &&
        (
          (request.resource.data.type == 'STOCK_IN' && request.resource.data.delta == request.resource.data.quantity) ||
          (request.resource.data.type == 'DISTRIBUTION' &&
            request.resource.data.delta == (0 - request.resource.data.quantity) &&
            request.resource.data.pangkalanId is string &&
            get(/databases/$(database)/documents/lpg_pangkalan/$(request.resource.data.pangkalanId)).data.agentId == request.resource.data.agentId &&
            get(/databases/$(database)/documents/lpg_pangkalan/$(request.resource.data.pangkalanId)).data.status == 'ACTIVE' &&
            get(/databases/$(database)/documents/lpg_pangkalan/$(request.resource.data.pangkalanId)).data.isDeleted == false) ||
          (request.resource.data.type == 'CORRECTION' &&
            isLpgAdmin() &&
            eventId == 'CORRECTION-' + request.resource.data.correctionOfEventId &&
            request.resource.data.correctionOfEventId is string &&
            (request.resource.data.delta == request.resource.data.quantity ||
             request.resource.data.delta == (0 - request.resource.data.quantity)) &&
            get(/databases/$(database)/documents/lpg_events/$(request.resource.data.correctionOfEventId)).data.agentId == request.resource.data.agentId) ||
          (request.resource.data.type == 'OPENING_BALANCE' &&
            isLpgAdmin() &&
            eventId == 'OPENING-' + request.resource.data.agentId &&
            request.resource.data.delta == request.resource.data.quantity)
        );
      allow update, delete: if false;
    }

    match /lpg_balances/{agentId} {
      allow read: if isLpgAdmin() || ownsLpgAgent(agentId);
      // Saldo HARUS diubah melalui Firestore Transaction atomik di submitLpgLedgerEvent().
      // existsAfter/getAfter memastikan write hanya valid dalam transaksi yang juga
      // membuat lpg_events yang sesuai — mencegah manipulasi saldo di luar ledger.
      allow create: if (ownsLpgAgent(agentId) || isLpgAdmin()) &&
        request.resource.data.agentId == agentId &&
        request.resource.data.filledCylinderBalance is int &&
        request.resource.data.filledCylinderBalance >= 0 &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.updatedAt == request.time &&
        existsAfter(/databases/$(database)/documents/lpg_events/$(request.resource.data.lastEventId)) &&
        getAfter(/databases/$(database)/documents/lpg_events/$(request.resource.data.lastEventId)).data.agentId == agentId &&
        getAfter(/databases/$(database)/documents/lpg_events/$(request.resource.data.lastEventId)).data.delta == request.resource.data.filledCylinderBalance;
      allow update: if (ownsLpgAgent(agentId) || isLpgAdmin()) &&
        request.resource.data.agentId == agentId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'filledCylinderBalance', 'lastEventId', 'updatedAt', 'updatedBy'
        ]) &&
        request.resource.data.filledCylinderBalance is int &&
        request.resource.data.filledCylinderBalance >= 0 &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.updatedAt == request.time &&
        existsAfter(/databases/$(database)/documents/lpg_events/$(request.resource.data.lastEventId)) &&
        getAfter(/databases/$(database)/documents/lpg_events/$(request.resource.data.lastEventId)).data.agentId == agentId &&
        getAfter(/databases/$(database)/documents/lpg_events/$(request.resource.data.lastEventId)).data.delta ==
          request.resource.data.filledCylinderBalance - resource.data.filledCylinderBalance;
      allow delete: if false;
    }

    match /lpg_outlet_change_requests/{requestId} {
      allow read: if isLpgAdmin() || ownsLpgAgent(resource.data.agentId);
      allow create: if signedIn() && ownsLpgAgent(request.resource.data.agentId) &&
        request.resource.data.requestId == requestId && request.resource.data.status == 'PENDING' &&
        request.resource.data.requestType in ['CREATE_OUTLET', 'DEACTIVATE_OUTLET', 'UPDATE_ADMIN_FIELD'] &&
        request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
      allow update: if isLpgAdmin();
      allow delete: if false;
    }

    match /lpg_audit_logs/{auditId} {
      allow read: if isLpgAdmin();
      allow create: if signedIn() &&
        request.resource.data.actorUid == request.auth.uid &&
        (isLpgAdmin() || ownsLpgAgent(request.resource.data.agentId)) &&
        request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /lpg_alerts/{alertId} {
      allow read: if isLpgAdmin();
      allow create: if isLpgAdmin() &&
        request.resource.data.status in ['OPEN', 'ACKNOWLEDGED', 'RESOLVED', 'DISMISSED'] &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if isLpgAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'note', 'acknowledgedBy', 'acknowledgedAt',
          'resolvedBy', 'resolvedAt', 'dismissedBy', 'dismissedAt',
          'updatedBy', 'updatedAt'
        ]) &&
        request.resource.data.status in ['OPEN', 'ACKNOWLEDGED', 'RESOLVED', 'DISMISSED'] &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /lpg_settings/{settingsId} {
      allow read: if signedIn();
      allow create, update: if isLpgAdmin() &&
        request.resource.data.keys().hasOnly([
          'reportingNormalHours', 'reportingLateHours', 'minimumStockCylinders',
          'noDeliveryAlertDays', 'hetPrice', 'hetRegulation', 'updatedBy', 'updatedAt'
        ]) &&
        request.resource.data.reportingNormalHours is int &&
        request.resource.data.reportingNormalHours >= 1 &&
        request.resource.data.reportingLateHours is int &&
        request.resource.data.reportingLateHours > request.resource.data.reportingNormalHours &&
        request.resource.data.minimumStockCylinders is int &&
        request.resource.data.minimumStockCylinders >= 0 &&
        request.resource.data.noDeliveryAlertDays is int &&
        request.resource.data.noDeliveryAlertDays >= 1 &&
        request.resource.data.hetPrice is int && request.resource.data.hetPrice > 0 &&
        request.resource.data.hetRegulation is string && request.resource.data.hetRegulation.size() > 0 &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /lpg_dashboard/{documentId} {
      allow read: if true;
      allow create, update: if isLpgAdmin() &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /lpg_daily_agent_summaries/{summaryId} {
      allow read: if isLpgAdmin() || ownsLpgAgent(resource.data.agentId);
      allow write: if false;
    }

    match /lpg_daily_kecamatan_summaries/{summaryId} {
      allow read: if true;
      allow write: if false;
    }

    // 4. PENGGUNA & RBAC
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isLpgAdmin());
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || (
        signedIn() && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone', 'bio', 'updatedAt']) &&
        request.resource.data.updatedAt == request.time
      );
      allow delete: if false;
    }

    // 5. PENYALUR BBM (SPBU, APMS, SPBUN, PERTASHOP)
    match /bbm_outlets/{outletId} {
      allow read: if true;
      // Validasi field-level mencegah injeksi HTML/script pada field teks publik.
      allow create, update: if (isLpgAdmin() || isSuperAdmin()) &&
        request.resource.data.nama is string &&
        request.resource.data.nama.size() > 0 &&
        request.resource.data.nama.size() <= 200 &&
        request.resource.data.kode is string &&
        request.resource.data.kode.size() > 0 &&
        request.resource.data.kode.size() <= 50 &&
        (request.resource.data.foto == null ||
          (request.resource.data.foto is string &&
           !request.resource.data.foto.matches('data:image.*') &&
           request.resource.data.foto.size() <= 2048));
      allow delete: if isSuperAdmin();
    }

    match /bbm_audit_logs/{logId} {
      allow read: if isLpgAdmin() || isSuperAdmin();
      allow create: if isLpgAdmin() || isSuperAdmin();
      allow update, delete: if false;
    }

  }
}
