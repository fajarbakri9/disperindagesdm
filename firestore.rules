rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function currentUserProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isLpgAdmin() {
      return signedIn() && currentUserProfile().status == 'ACTIVE' &&
        currentUserProfile().role in [
          'SUPER_ADMIN', 'DISPERINDAG_ADMIN', 'LPG_ADMIN', 'INDUSTRY_ESDM_EDITOR'
        ];
    }

    function isSuperAdmin() {
      return signedIn() && currentUserProfile().status == 'ACTIVE' &&
        currentUserProfile().role == 'SUPER_ADMIN';
    }

    function ownsLpgAgent(agentId) {
      return signedIn() && currentUserProfile().status == 'ACTIVE' &&
        currentUserProfile().agentId != null && currentUserProfile().agentId == agentId;
    }
    
    // 1. DATA PUBLIK KEDINASAN (Dapat dibaca siapa saja, diedit oleh staf berwenang)
    match /prices/{docId} {
      allow read: if true;
      allow write: if true;
    }
    // Snapshot harga aktif untuk wallboard; histori dipisahkan agar listener tetap ringan.
    match /prices_current/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /price_history/{docId} {
      allow read, write: if request.auth != null;
    }
    match /sembako/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /news/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /ikm_products/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /documents/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /banners/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /command_center/{document=**} {
      allow read, write: if true;
    }
    match /districts/{docId} {
      allow read, write: if true;
    }
    match /markets/{docId} {
      allow read, write: if true;
    }
    match /skm/{docId} {
      allow read, write: if true;
    }

    // 4. MEDIA INTELLIGENCE — DATA CRAWLER RSS + GEMINI AI
    // Read : publik — website bisa fetch data
    // Write: dibuka (Firestore rules tidak bisa bedakan Apps Script vs browser,
    //         data ini bersifat publik sehingga aman allow write: if true)
    match /media_intelligence_feeds/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /media_intelligence_summary/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /media_intelligence_trending/{docId} {
      allow read: if true;
      allow write: if true;
    }
    // Snapshot TV Wallboard — 1 dokumen berisi 10 berita terbaru
    match /dashboard_snapshot/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /dashboard/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /config/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    match /mentions/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /issues/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // 2. KANAL PENGADUAN MASYARAKAT (SP4N-LAPOR! & WEBSITE)
    // Publik boleh membuat aduan dengan validasi input terproteksi (UU PDP No. 27/2022)
    match /reports/{reportId} {
      allow create: if request.resource.data.pesan != null && request.resource.data.pesan.size() > 5;
      allow read, update, delete: if request.auth != null;
    }
    // Proyeksi laporan yang sudah disanitasi dan aman ditampilkan pada wallboard publik.
    match /reports_current/{reportId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 3. MODUL LPG - ledger append-only dan saldo hanya ditulis Admin SDK.
    match /lpg_agents/{agentId} {
      allow read: if isLpgAdmin() || ownsLpgAgent(agentId);
      allow create, update: if isLpgAdmin();
      allow delete: if false;
    }

    match /lpg_pangkalan/{pangkalanId} {
      allow read: if isLpgAdmin() || ownsLpgAgent(resource.data.agentId);
      allow create: if isLpgAdmin() || (
        ownsLpgAgent(request.resource.data.agentId) &&
        request.resource.data.status == 'ACTIVE' &&
        request.resource.data.isDeleted == false &&
        request.resource.data.verificationStatus == 'PENDING_ADMIN_VERIFICATION'
      );
      allow update: if isLpgAdmin() || (
        ownsLpgAgent(resource.data.agentId) &&
        request.resource.data.agentId == resource.data.agentId &&
        request.resource.data.sourceOriginal == resource.data.sourceOriginal &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'normalizedName', 'ownerName', 'phone', 'kecamatan',
          'desaKelurahan', 'address', 'latitude', 'longitude',
          'monthlyAllocation', 'notes', 'status', 'isDeleted', 'deletedAt',
          'deletedBy', 'deleteReason', 'updatedAt', 'updatedBy'
        ])
      );
      allow delete: if false;
    }

    match /lpg_events/{eventId} {
      allow read: if isLpgAdmin() || ownsLpgAgent(resource.data.agentId);
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly([
          'agentId', 'clientEventId', 'type', 'quantity', 'delta',
          'pangkalanId', 'pangkalanSnapshot', 'effectiveAt', 'doNumber',
          'vehicleNumber', 'note', 'correctionOfEventId', 'createdBy', 'createdAt'
        ]) &&
        (ownsLpgAgent(request.resource.data.agentId) || isLpgAdmin()) &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.quantity is int &&
        request.resource.data.quantity > 0 &&
        request.resource.data.createdAt == request.time &&
        (
          (request.resource.data.type == 'STOCK_IN' && request.resource.data.delta == request.resource.data.quantity) ||
          (request.resource.data.type == 'DISTRIBUTION' &&
            request.resource.data.delta == (0 - request.resource.data.quantity) &&
            request.resource.data.pangkalanId is string &&
            get(/databases/$(database)/documents/lpg_pangkalan/$(request.resource.data.pangkalanId)).data.agentId == request.resource.data.agentId &&
            get(/databases/$(database)/documents/lpg_pangkalan/$(request.resource.data.pangkalanId)).data.status == 'ACTIVE' &&
            get(/databases/$(database)/documents/lpg_pangkalan/$(request.resource.data.pangkalanId)).data.isDeleted == false) ||
          (request.resource.data.type == 'CORRECTION' &&
            isLpgAdmin() &&
            eventId == 'CORRECTION-' + request.resource.data.correctionOfEventId &&
            request.resource.data.correctionOfEventId is string &&
            (request.resource.data.delta == request.resource.data.quantity ||
             request.resource.data.delta == (0 - request.resource.data.quantity)) &&
            get(/databases/$(database)/documents/lpg_events/$(request.resource.data.correctionOfEventId)).data.agentId == request.resource.data.agentId) ||
          (request.resource.data.type == 'OPENING_BALANCE' &&
            isLpgAdmin() &&
            eventId == 'OPENING-' + request.resource.data.agentId &&
            request.resource.data.delta == request.resource.data.quantity)
        );
      allow update, delete: if false;
    }

    match /lpg_balances/{agentId} {
      allow read: if isLpgAdmin() || ownsLpgAgent(agentId);
      allow write: if false;
    }

    match /lpg_audit_logs/{auditId} {
      allow read: if isLpgAdmin();
      allow create: if signedIn() &&
        request.resource.data.actorUid == request.auth.uid &&
        (isLpgAdmin() || ownsLpgAgent(request.resource.data.agentId)) &&
        request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /lpg_alerts/{alertId} {
      allow read: if isLpgAdmin();
      allow create: if isLpgAdmin() &&
        request.resource.data.status in ['OPEN', 'ACKNOWLEDGED', 'RESOLVED', 'DISMISSED'] &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if isLpgAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'note', 'acknowledgedBy', 'acknowledgedAt',
          'resolvedBy', 'resolvedAt', 'dismissedBy', 'dismissedAt',
          'updatedBy', 'updatedAt'
        ]) &&
        request.resource.data.status in ['OPEN', 'ACKNOWLEDGED', 'RESOLVED', 'DISMISSED'] &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /lpg_dashboard/{documentId} {
      allow read: if true;
      allow create, update: if isLpgAdmin() &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /lpg_daily_agent_summaries/{summaryId} {
      allow read: if isLpgAdmin() || ownsLpgAgent(resource.data.agentId);
      allow write: if false;
    }

    match /lpg_daily_kecamatan_summaries/{summaryId} {
      allow read: if true;
      allow write: if false;
    }

    // 4. PENGGUNA & RBAC (Hanya dapat diakses melalui autentikasi resmi)
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isLpgAdmin());
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || (
        signedIn() && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone', 'bio', 'updatedAt']) &&
        request.resource.data.updatedAt == request.time
      );
      allow delete: if false;
    }
  }
}
