# Pinrang Issue Discovery Engine - Environment Variables Example
# Salin file ini menjadi .env dan isi dengan kredensial yang sesuai

# Gemini API Key (dari https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Firebase Project ID (untuk REST API collector)
FIREBASE_PROJECT_ID=disperindagesdm-pinrang

# Firebase API Key (dari Firebase Console > Project Settings)
FIREBASE_API_KEY=AIzaSyD4J1kidUcBcz7EdmYRIJ66YR5jOEO477I

# Service Account JSON (opsional - untuk collector lokal dengan full write access)
FIREBASE_SA_PATH=
